# Comma-separated MetaMask PUBLIC addresses permitted to register anchors.
# No wallet private key is needed or accepted by this application.
ANCHOR_ALLOWED_WALLETS=
# Optional trusted Polygon Amoy RPC endpoint (chain ID 80002).
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Configure both for persistent shared evidence and alerts (recommended for deployment).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional background monitor target; leave localhost for local use.
MONITOR_URL=http://127.0.0.1:3000
